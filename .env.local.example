# Copy this file to .env.local and add your Supabase project values.
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# OPTIONAL — makes calls work on more mobile networks (a "TURN relay").
# You can rent one (for example from Metered, Twilio or Xirsys) or run your own (coturn).
# Leave these out and calls still work on many networks; they just fail on some.
# NEXT_PUBLIC_TURN_URL=turn:your-server.example.com:3478
# NEXT_PUBLIC_TURN_USERNAME=your-username
# NEXT_PUBLIC_TURN_CREDENTIAL=your-password

# OPTIONAL: GIF search in the emoji/sticker panel. Free key from developers.giphy.com. Leave out to hide the GIF tab.
# NEXT_PUBLIC_GIPHY_KEY=your-giphy-key
